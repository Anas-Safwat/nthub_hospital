<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hospital Group Category -->
    <record id="module_category_hospital" model="ir.module.category">
        <field name="name">Hospital</field>
        <field name="sequence">10</field>
    </record>


    <!-- Privileges -->
    <record id="previllege_hospital" model="res.groups.privilege">
        <field name="name">Hospital Management</field>
        <field name="category_id" ref="module_category_hospital" />
        <field name="sequence">20</field>
    </record>

    <!-- Base Group -->
    <record id="group_hospital_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="sequence">1</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- Role-Based Groups -->
    <record id="group_hospital_patient" model="res.groups">
        <field name="name">Patient</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]" />
    </record>

    <record id="group_hospital_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]" />
    </record>

    <record id="group_hospital_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]" />
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]" />
    </record>

    <!-- Manager Group -->
    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="previllege_hospital" />
        <field name="sequence">2</field>
        <field name="implied_ids"
            eval="[
            (4, ref('group_hospital_user')),
            (4, ref('group_hospital_patient')),
            (4, ref('group_hospital_receptionist')),
            (4, ref('group_hospital_nurse')),
            (4, ref('group_hospital_doctor')),
        ]" />
    </record>

</odoo>