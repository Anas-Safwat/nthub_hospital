<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hospital_doctor_view_list" model="ir.ui.view">
        <field name="name">hospital.doctor.view.list</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="license_no" />
            </list>
        </field>
    </record>

    <record id="hospital_doctor_view_form" model="ir.ui.view">
        <field name="name">hospital.doctor.view.form</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- ── Smart Buttons ── -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Req #7: Appointments smart button (booked calendar.event records) -->
                        <button name="action_view_appointments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar-check-o">
                            <field name="appointment_count" string="Appointments"
                                widget="statinfo" />
                        </button>
                    </div>

                    <!-- ── Avatar + Name ── -->
                    <div class="d-flex flex-column flex-sm-row align-items-center">
                        <div class="o_employee_avatar ms-2 p-0">
                            <field name="image_1920" widget="image" class="m-0"
                                options="{&quot;size&quot;: [128,158], &quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;avatar_128&quot;}" />
                            <field name="show_hr_icon_display" invisible="1" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-7 col-lg-8 px-4">
                            <div class="oe_title mw-100 ps-0 pe-sm-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" placeholder="Doctor's Name" required="True"
                                        style="font-size: min(4vw, 2.6rem);" />
                                </h1>
                                <h5 class="d-flex align-items-baseline mb-0">
                                    <i class="fa fa-envelope fa-fw me-1 text-primary"
                                        title="Work Email" />
                                    <field name="work_email" widget="email"
                                        placeholder="e.g. dr_ahmed@hospital.com" string="Work Email"
                                        class="w-100 w-sm-75" />
                                </h5>
                                <h5 class="d-flex align-items-baseline mb-0">
                                    <i class="fa fa-mobile fa-fw me-1 text-primary"
                                        title="Work Mobile" />
                                    <field name="mobile_phone" widget="phone"
                                        placeholder="Work Mobile" string="Work Mobile"
                                        class="w-100 w-sm-75" />
                                </h5>
                            </div>
                        </div>
                    </div>

                    <!-- ── Main Info Groups ── -->
                    <group>
                        <group string="Medical Information">
                            <field name="license_no" />
                            <field name="specialization_id" />
                            <field name="department_id" />
                        </group>
                        <group string="Clinic &amp; Consultation">
                            <field name="clinic_ids" widget="many2many_tags" readonly="1"
                                string="Clinics (from Schedule)"
                                options="{'no_create': True, 'no_edit': True}" />
                            <field name="consultation_duration" widget="float_time" />
                        </group>
                    </group>

                    <!-- ── Notebook ── -->
                    <notebook>
                        <page name="schedule" string="Schedule">
                            <field name="attendance_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1" column_invisible="True" />
                                    <field name="clinic_id" />
                                    <field name="dayofweek" />
                                    <field name="hour_from" widget="float_time" />
                                    <field name="hour_to" widget="float_time" />
                                </list>
                            </field>
                        </page>

                        <!-- Req #6: Clinics Validity page -->
                        <page string="Clinics Validity" name="clinics_validity">
                            <p class="text-muted" invisible="appointment_type_ids">
                                Add at least one schedule slot for a clinic to configure
                                availability periods.
                            </p>
                            <field name="appointment_type_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="clinic_id" readonly="1" string="Clinic" />
                                    <field name="start_datetime"
                                        string="Available From"
                                        help="Start of the period during which the doctor is available at this clinic." />
                                    <field name="end_datetime"
                                        string="Available Until"
                                        help="End of the period during which the doctor is available at this clinic." />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employment_type', '=', 'doctor')]</field>
        <field name="context">{'default_employment_type' : 'doctor'}</field>
        <field name="view_ids"
            eval="[(5,0,0),
        (0,0,{'view_mode':'list', 'view_id':ref('hospital_doctor_view_list')}),
        (0,0,{'view_mode':'form', 'view_id': ref('hospital_doctor_view_form')})]" />
    </record>
</odoo>