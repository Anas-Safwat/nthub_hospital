<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         VISIT — SEARCH VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_visit_view_search" model="ir.ui.view">
        <field name="name">hospital.visit.view.search</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Search Visits">
                <field name="patient_id" string="Patient" />
                <field name="doctor_id" string="Doctor" />
                <field name="visit_date" string="Visit Date" />
                <field name="appointment_id" string="Appointment" />

                <filter name="filter_draft" string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter name="filter_paid" string="Paid"
                    domain="[('state', '=', 'paid')]" />
                <filter name="filter_in_progress" string="In Progress"
                    domain="[('state', '=', 'in_progress')]" />
                <filter name="filter_done" string="Done"
                    domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="filter_first_visit" string="First Visit"
                    domain="[('visit_type', '=', 'first_visit')]" />
                <filter name="filter_follow_up" string="Follow Up"
                    domain="[('visit_type', '=', 'follow_up')]" />
                <filter name="filter_consultation" string="Consultation"
                    domain="[('visit_type', '=', 'consultation')]" />
                <separator />
                <filter name="filter_today" string="Today"
                    domain="[('visit_date', '=', context_today().strftime('%Y-%m-%d'))]" />

                <group>
                    <filter name="group_doctor" string="Doctor"
                        context="{'group_by': 'doctor_id'}" />
                    <filter name="group_patient" string="Patient"
                        context="{'group_by': 'patient_id'}" />
                    <filter name="group_visit_type" string="Visit Type"
                        context="{'group_by': 'visit_type'}" />
                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}" />
                    <filter name="group_visit_date" string="Visit Date"
                        context="{'group_by': 'visit_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         VISIT — LIST VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_visit_view_list" model="ir.ui.view">
        <field name="name">hospital.visit.view.list</field>
        <field name="model">hospital.visit</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Patient Visits"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'paid'"
                decoration-success="state == 'in_progress'"
                decoration-muted="state == 'done'">
                <field name="patient_id" />
                <field name="doctor_id" />
                <field name="visit_date" />
                <field name="visit_type" widget="badge"
                    decoration-primary="visit_type == 'first_visit'"
                    decoration-success="visit_type == 'follow_up'"
                    decoration-warning="visit_type == 'consultation'" />
                <field name="amount_total" widget="monetary" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'paid'"
                    decoration-success="state == 'in_progress'"
                    decoration-muted="state == 'done'" />
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         VISIT — FORM VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_visit_view_form" model="ir.ui.view">
        <field name="name">hospital.visit.view.form</field>
        <field name="model">hospital.visit</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Patient Visit">
                <header>
                    <button name="action_start_visit"
                        string="Start Visit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'paid'" />
                    <button name="action_checkout"
                        string="Check-out"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'in_progress'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,paid,in_progress,done" />
                </header>
                <sheet>
                    <!-- ── Smart Buttons ── -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_payment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not payment_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                        <button name="action_view_picking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="not picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Delivery</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="Patient &amp; Doctor">
                            <field name="patient_id"
                                readonly="state != 'draft'" />
                            <field name="doctor_id"
                                readonly="state != 'draft'" />
                            <field name="clinic_id"
                                readonly="state == 'done'" />
                        </group>
                        <group string="Visit Details">
                            <field name="visit_date"
                                readonly="state != 'draft'" />
                            <field name="visit_type" widget="badge"
                                decoration-primary="visit_type == 'first_visit'"
                                decoration-success="visit_type == 'follow_up'"
                                decoration-warning="visit_type == 'consultation'" />
                            <field name="appointment_id" readonly="1"
                                invisible="not appointment_id" />
                            <field name="invoice_id" readonly="1"
                                invisible="not invoice_id" />
                            <field name="payment_id" readonly="1"
                                invisible="not payment_id" />
                            <field name="amount_total" widget="monetary" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page name="assessment" string="Assessment">
                            <field name="assessment_notes"
                                placeholder="Enter clinical assessment notes..."
                                readonly="state != 'in_progress'" />
                        </page>
                        <page name="services" string="Services">
                            <field name="service_line_ids"
                                readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="product_id"
                                        readonly="invoice_line_id" />
                                    <field name="invoice_line_id" readonly="1"
                                        optional="hide" />
                                    <field name="currency_id"
                                        column_invisible="True" />
                                </list>
                            </field>
                        </page>
                        <page name="medicines" string="Medicines">
                            <field name="medicine_line_ids"
                                readonly="state != 'in_progress'">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="dosage" />
                                    <field name="frequency" />
                                    <field name="duration" />
                                    <field name="quantity" />
                                    <field name="instructions" optional="hide" />
                                    <field name="invoice_line_id" readonly="1"
                                        optional="hide" />
                                    <field name="currency_id"
                                        column_invisible="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         VISIT — ACTION
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hospital.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hospital_visit_view_search" />
        <field name="context">{'search_default_filter_paid': 1, 'search_default_filter_in_progress':
            1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No paid visits found
            </p>
            <p>
                Visits appear here automatically once their appointment payment is registered.
            </p>
        </field>
    </record>

</odoo>