<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         APPOINTMENT — SEARCH VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_appointment_view_search" model="ir.ui.view">
        <field name="name">hospital.appointment.view.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="patient_id" string="Patient" />
                <field name="doctor_id" string="Doctor" />
                <field name="appointment_date" string="Date" />
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="filter_confirmed" string="Confirmed"
                    domain="[('state', '=', 'confirmed')]" />
                <filter name="filter_cancelled" string="Cancelled"
                    domain="[('state', '=', 'cancelled')]" />
                <separator />
                <filter name="filter_today" string="Today"
                    domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter name="filter_upcoming" string="Upcoming"
                    domain="[('appointment_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <group>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}" />
                    <filter name="group_date" string="Date"
                        context="{'group_by': 'appointment_date'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         APPOINTMENT — LIST VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_appointment_view_list" model="ir.ui.view">
        <field name="name">hospital.appointment.view.list</field>
        <field name="model">hospital.appointment</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Appointments"
                decoration-info="state == 'draft'"
                decoration-success="state in ('confirmed', 'paid')"
                decoration-muted="state == 'cancelled'">
                <field name="patient_id" />
                <field name="doctor_id" />
                <field name="visit_type" widget="badge"
                    decoration-primary="visit_type == 'first_visit'"
                    decoration-success="visit_type == 'follow_up'"
                    decoration-warning="visit_type == 'consultation'" />
                <field name="appointment_date" />
                <field name="slot_id" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-warning="state == 'paid'"
                    decoration-danger="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         APPOINTMENT — FORM VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_appointment_view_form" model="ir.ui.view">
        <field name="name">hospital.appointment.view.form</field>
        <field name="model">hospital.appointment</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="action_register_payment"
                        string="Register Payment"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'confirmed' or visit_state != 'draft'" />
                    <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'confirmed')"
                        confirm="Are you sure you want to cancel this appointment? The slot will become available again." />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_payment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not payment_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                    </div>
                    <field name="visit_state" invisible="1" />
                    <field name="payment_id" invisible="1" />
                    <group>
                        <group string="Patient">
                            <field name="patient_id" />
                            <field name="patient_name" />
                            <field name="patient_phone" />
                            <field name="visit_type" readonly="state != 'draft'" />
                        </group>
                        <group string="Doctor &amp; Schedule">
                            <field name="doctor_id" />
                            <field name="appointment_date" />
                            <field name="timetable_id" invisible="1" />
                            <field name="slot_id" />
                            <field name="slot_type" widget="badge"
                                decoration-info="slot_type == 'consultation'"
                                decoration-warning="slot_type == 'operation'" />
                        </group>
                    </group>

                    <group invisible="state == 'draft'">
                        <group string="Linked Records">
                            <field name="visit_id" readonly="1" />
                            <field name="invoice_id" readonly="1" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         APPOINTMENT — ACTION
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_appointment_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hospital_appointment_view_search" />
        <field name="context">{'search_default_filter_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No appointments yet
            </p>
            <p> Go to <b>Available Slots</b> and click <b>Book</b> to create an appointment for a
                patient. </p>
        </field>
    </record>

</odoo>