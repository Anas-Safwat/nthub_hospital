<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="hospital_appointment_view_list" model="ir.ui.view">
        <field name="name">hospital.appointment.view.list</field>
        <field name="model">calendar.event</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list>
            </list>
        </field>
    </record>

    <record id="hospital_appointment_view_form" model="ir.ui.view">
        <field name="name">hospital.appointment.view.form</field>
        <field name="model">calendar.event</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_appointment_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
            eval="[
        (5,0,0),
        (0,0,{'view_mode':'list', 'view_id':ref('hospital_appointment_view_list')}),
        (0,0,{'view_mode':'form', 'view_id':ref('hospital_appointment_view_form')}),]" />
    </record>

</odoo>