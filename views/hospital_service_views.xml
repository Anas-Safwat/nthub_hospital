<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         HOSPITAL SERVICE — LIST VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_service_view_list" model="ir.ui.view">
        <field name="name">hospital.service.view.list</field>
        <field name="model">hospital.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="product_id" />
                <field name="price" widget="monetary" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         HOSPITAL SERVICE — FORM VIEW
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_service_view_form" model="ir.ui.view">
        <field name="name">hospital.service.view.form</field>
        <field name="model">hospital.service</field>
        <field name="arch" type="xml">
            <form string="Hospital Service">
                <sheet>
                    <group>
                        <group string="Service Details">
                            <field name="name" />
                            <field name="sequence" />
                            <field name="product_id" />
                            <field name="price" widget="monetary" />
                            <field name="active" />
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"
                                placeholder="Describe this service..." />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         HOSPITAL SERVICE — ACTION
         ════════════════════════════════════════════════════════════════ -->
    <record id="hospital_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hospital.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the services your hospital offers
            </p>
            <p>
                Create services like Consultation and Operation with
                standardized prices. These are automatically assigned
                to new doctors.
            </p>
        </field>
    </record>

</odoo>
