<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         ROOT MENU
         ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="hospital_menu"
        name="Hospital"
        sequence="50" />

    <!-- ═══════════════════════════════════════════════════════
         OPERATIONS — Daily workflow
         ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="hospital_operations_menu"
        name="Operations"
        parent="hospital_menu"
        sequence="10" />
    <menuitem
        id="hospital_patient_menu"
        name="Patients"
        action="hospital_patient_action"
        parent="hospital_operations_menu"
        sequence="5" />
    <menuitem
        id="hospital_appointments_menu"
        name="Appointments"
        action="hospital_appointment_action"
        parent="hospital_operations_menu"
        sequence="10" />
    <menuitem
        id="hospital_available_slots_menu"
        name="Reservations"
        action="hospital_timetable_slot_action"
        parent="hospital_operations_menu"
        sequence="20" />
    <menuitem
        id="hospital_visits_menu"
        name="Visits"
        action="hospital_visit_action"
        parent="hospital_operations_menu"
        sequence="30" />

    <!-- ═══════════════════════════════════════════════════════
         STAFF — Hospital personnel
         ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="hospital_staff_menu"
        name="Staff"
        parent="hospital_menu"
        sequence="20" />
    <menuitem
        id="hospital_doctor_menu"
        name="Doctors"
        action="hospital_doctor_action"
        parent="hospital_staff_menu"
        sequence="10" />
    <menuitem
        id="hospital_nurse_menu"
        name="Nurses"
        action="hospital_nurse_action"
        parent="hospital_staff_menu"
        sequence="20" />
    <menuitem
        id="hospital_receptionist_menu"
        name="Receptionists"
        action="hospital_receptionist_action"
        parent="hospital_staff_menu"
        sequence="30" />

    <!-- ═══════════════════════════════════════════════════════
         FACILITIES — Organizational structure
         ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="hospital_facilities_menu"
        name="Facilities"
        parent="hospital_menu"
        sequence="30" />
    <menuitem
        id="hospital_department_menu"
        name="Departments"
        action="hospital_department_action"
        parent="hospital_facilities_menu"
        sequence="10" />
    <menuitem
        id="hospital_clinics_menu"
        name="Clinics"
        action="hospital_clinic_action"
        parent="hospital_facilities_menu"
        sequence="20" />

    <!-- ═══════════════════════════════════════════════════════
         CONFIGURATION — Setup & reference data
         ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="hospital_configuration_menu"
        name="Configuration"
        parent="hospital_menu"
        sequence="100" />
    <menuitem
        id="hospital_timetable_menu"
        name="Timetables"
        action="hospital_timetable_action"
        parent="hospital_configuration_menu"
        sequence="10" />
    <menuitem
        id="hospital_service_menu"
        name="Services"
        action="hospital_service_action"
        parent="hospital_configuration_menu"
        sequence="20" />

    <record id="hospital_medicine_list_view" model="ir.ui.view">
        <field name="name">product.product.medicine.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Medicines">
                <field name="name" string="Medicine" />
                <field name="lst_price" string="Sales Price" />
                <field name="uom_id" string="Unit" />
                <field name="qty_available" string="On Hand" />
            </list>
        </field>
    </record>

    <record id="hospital_medicine_action" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hospital_medicine_list_view" />
        <field name="domain">[('is_storable', '=', True)]</field>
        <field name="context">{'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new medicine
            </p>
            <p>
                Create storable products that doctors can prescribe
                during visits.
            </p>
        </field>
    </record>
    <menuitem
        id="hospital_medicine_menu"
        name="Medicines"
        action="hospital_medicine_action"
        parent="hospital_configuration_menu"
        sequence="30" />

</odoo>