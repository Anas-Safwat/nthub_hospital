<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hospital_nurse_view_list" model="ir.ui.view">
        <field name="name">hospital.nurse.view.list</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="nursing_level" />
            </list>
        </field>
    </record>

    <record id="hospital_nurse_view_form" model="ir.ui.view">
        <field name="name">hospital.nurse.view.form</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Info">
                            <field name="name" string="Name" />
                            <field name="nursing_level" />
                        </group>
                        <group string="Specialization">
                            <field name="specialization_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_nurse_action" model="ir.actions.act_window">
        <field name="name">Nurses</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employment_type', '=', 'nurse')]</field>
        <field name="context">{'default_employment_type' : 'nurse'}</field>
        <field name="view_ids"
            eval="[
        (5,0,0),
        (0,0,{'view_mode':'list', 'view_id':ref('hospital_nurse_view_list')}),
        (0,0,{'view_mode':'form', 'view_id':ref('hospital_nurse_view_form')}),]" />
    </record>
</odoo>