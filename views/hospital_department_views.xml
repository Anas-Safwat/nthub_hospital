<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hospital_department_view_list" model="ir.ui.view">
        <field name="name">hospital.department.view.list</field>
        <field name="model">hr.department</field>
        <field name="priority">99</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="hospital_department_view_form" model="ir.ui.view">
        <field name="name">hospital.department.view.form</field>
        <field name="model">hr.department</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Info">
                            <field name="name" />
                        </group>
                        <group string="Clinics">
                            <field name="is_clinical" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="hospital_department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
            eval="[(5,0,0),
            (0,0,{'view_mode' : 'list', 'view_id' : ref('hospital_department_view_list')}),
            ((0,0,{'view_mode' : 'form', 'view_id' : ref('hospital_department_view_form')}))]" />
    </record>

</odoo>